# Hangi kulüp? src/kulup/kulupler/<kod>.json  (varsayılan: denizlispor)
NEXT_PUBLIC_KULUP=denizlispor

# İsteğe bağlı. Kulübün projesiyle (kulup.json › supabase.proje) uyuşmayan adres YOK SAYILIR.
# Yalnızca publishable (anon) anahtar yazılır; service_role anahtarı ASLA istemci ortamına konmaz.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
